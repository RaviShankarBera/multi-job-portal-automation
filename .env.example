# ============================================
# Multi Job Portal Automation Tool
# Environment Variables Template
# ============================================

# ==========================================
# PostgreSQL Configuration
# ==========================================
POSTGRES_DB=jobportal
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# ==========================================
# Redis Configuration
# ==========================================
REDIS_PASSWORD=redispassword
REDIS_PORT=6379

# ==========================================
# Backend Configuration
# ==========================================
BACKEND_PORT=8000
SECRET_KEY=your-secret-key-change-in-production
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=info

# ==========================================
# Celery Configuration
# ==========================================
CELERY_CONCURRENCY=4
CELERY_LOG_LEVEL=info

# ==========================================
# Frontend Configuration
# ==========================================
FRONTEND_PORT=3000
NODE_ENV=production
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ==========================================
# Database URLs (Auto-generated from above)
# ==========================================
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/jobportal
REDIS_URL=redis://:redispassword@redis:6379/0
CELERY_BROKER_URL=redis://:redispassword@redis:6379/1
CELERY_RESULT_BACKEND=redis://:redispassword@redis:6379/2
