# ============================================
# Multi Job Portal Automation Tool
# Environment Variables
# ============================================

# Database (SQLite for local dev - no install needed)
DATABASE_URL=sqlite+aiosqlite:///./jobportal.db

# PostgreSQL (for production - uncomment below)
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/jobportal

# Redis (optional - leave empty to disable background tasks)
# REDIS_URL=redis://localhost:6379/0

# JWT Secret (change in production!)
SECRET_KEY=dev-secret-key-change-in-production-12345

# Environment
ENVIRONMENT=development
DEBUG=true

# AI Provider (use "mock" for testing without API key)
AI_PROVIDER=mock
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-your-key-here

# Frontend URL
NEXT_PUBLIC_API_URL=http://localhost:8000
